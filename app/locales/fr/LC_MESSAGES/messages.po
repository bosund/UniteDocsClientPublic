msgid "Kopiér tekst fra %d side(r)"
msgstr "Copier le texte de %d page(s)"

#: app/dialogs.py:1456
msgid "Pseudonymisér personoplysninger først"
msgstr "Pseudonymiser d'abord les données personnelles"

#: app/dialogs.py:1464
msgid ""
"Skal teksten uploades til en AI-tjeneste, bør du gøre det. Navne, CPR-"
"numre og adresser byttes ud med etiketter som «Person 1». Ombytningen kan"
" ikke fortrydes, og den REDUCERER — den fjerner ikke — risikoen for at "
"nogen kan genkendes."
msgstr ""
"Si le texte doit être envoyé à un service d'IA, vous devriez le faire. "
"Les noms, numéros CPR et adresses sont remplacés par des étiquettes comme"
" «Personne 1». Le remplacement est irréversible et il RÉDUIT — sans le "
"supprimer — le risque que quelqu'un soit reconnu."

#: app/dialogs.py:1474
msgid "Sprogmodellen er ikke installeret, så teksten kan kun kopieres som den er."
msgstr ""
"Le modèle de langue n'est pas installé ; le texte ne peut être copié que "
"tel quel."

#: app/dialogs.py:1480
msgid "Gennemgå fundene før kopiering"
msgstr "Examiner les résultats avant de copier"

#: app/dialogs.py:1488
msgid "Så kan du fravælge fx din egen klients navn, inden teksten byttes om."
msgstr ""
"Vous pourrez alors décocher par exemple le nom de votre propre client "
"avant le remplacement."

#: app/dialogs.py:1494
msgid "Sider uden tekstlag læses automatisk med tekstgenkendelse."
msgstr ""
"Les pages sans couche de texte sont lues automatiquement par "
"reconnaissance de texte."

#: app/dialogs.py:1500 app/page_canvas.py:983
msgid "Kopiér"
msgstr "Copier"

#: app/dialogs.py:1537
msgid "Teksten er kopieret"
msgstr "Le texte a été copié"

#: app/dialogs.py:1542
#, python-format
