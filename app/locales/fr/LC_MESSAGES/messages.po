#: app/dialogs.py:1560
msgid "Der blev ikke fundet nogen personoplysninger at bytte ud."
msgstr "Aucune donnée personnelle à remplacer n'a été trouvée."

#: app/dialogs.py:1563
msgid "Teksten er IKKE pseudonymiseret."
msgstr "Le texte n'est PAS pseudonymisé."

#: app/dialogs.py:1582
msgid "Gem navneoversigt…"
msgstr "Enregistrer la table des noms…"

#: app/dialogs.py:1586
