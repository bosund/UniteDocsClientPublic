msgstr "%(tegn)s caractères provenant de %(sider)d page(s)."

#: app/dialogs.py:1549
#, python-format
msgid "%d personoplysning(er) er byttet ud med pseudonymer."
msgstr "%d donnée(s) personnelle(s) ont été remplacées par des pseudonymes."

#: app/dialogs.py:1553
msgid "Der blev ikke fundet nogen personoplysninger at bytte ud."
msgstr "Aucune donnée personnelle à remplacer n'a été trouvée."

#: app/dialogs.py:1556
msgid "Teksten er IKKE pseudonymiseret."
msgstr "Le texte n'est PAS pseudonymisé."

#: app/dialogs.py:1575
msgid "Gem navneoversigt…"
msgstr "Enregistrer la table des noms…"

#: app/dialogs.py:1579
msgid ""
"Oversigten kobler pseudonym og original. Den må ikke uploades sammen med "
"teksten."
msgstr ""
"La table relie le pseudonyme à l'original. Elle ne doit pas être envoyée "
"avec le texte."

