#: app/dialogs.py:1039
msgid "Læs også scannede sider (tekstgenkendelse)"
msgstr "Lire aussi les pages numérisées (reconnaissance de texte)"

#: app/dialogs.py:1043
msgid "Scannede sider tager længere tid, men findes ellers slet ikke."
msgstr ""
"Les pages numérisées prennent plus de temps, mais sinon elles ne sont pas"
" trouvées du tout."

#: app/dialogs.py:1102
#, python-format
msgid "%(valgt)d af %(alle)d forekomster maskeres"
msgstr "%(valgt)d occurrences sur %(alle)d seront caviardées"

#: app/dialogs.py:1111
msgid "Vælg alle"
msgstr "Tout sélectionner"

#: app/dialogs.py:1112
msgid "Fravælg alle"
msgstr "Tout désélectionner"

#: app/dialogs.py:1124
msgid "Masker de valgte"
msgstr "Caviarder la sélection"

#: app/dialogs.py:1139
#, python-format
msgid "%(fund)d forekomster fordelt på %(grupper)d værdier"
msgstr "%(fund)d occurrences réparties sur %(grupper)d valeurs"

#: app/dialogs.py:1146
msgid ""
"Alt er valgt. Fjern fluebenet ved det der IKKE skal maskeres — fx "
"advokatens eller dommerens navn."
msgstr ""
"Tout est sélectionné. Décochez ce qui ne doit PAS être caviardé — par "
"exemple le nom de l'avocat ou du juge."

#: app/dialogs.py:1154 app/dialogs.py:1562
#, python-format
msgid ""
"%d side(r) blev læst med tekstgenkendelse. Kontrollér resultatet — "
"genkendelsen kan have overset tekst."
msgstr ""
"%d page(s) ont été lues par reconnaissance de texte. Vérifiez le résultat"
" — la reconnaissance a pu manquer du texte."

#: app/dialogs.py:1160
#, python-format
msgid "%d side(r) er læst som engelsk tekst ud over dansk."
msgstr "%d page(s) ont été lues comme du texte anglais en plus du danois."

#: app/dialogs.py:1167
#, python-format
msgid ""
"%d side(r) ser engelske ud, men den engelske sprogmodel er ikke "
"installeret. Numre og adresser er fundet, men engelske navne kan være "
"overset."
msgstr ""
"%d page(s) semblent être en anglais, mais le modèle linguistique anglais "
"n'est pas installé. Les numéros et les adresses ont été trouvés, mais des"
" noms anglais peuvent avoir été manqués."

#: app/dialogs.py:1173 app/dialogs.py:1569
#, python-format
msgid "%d side(r) kunne ikke læses."
msgstr "%d page(s) n'ont pas pu être lues."

#: app/dialogs.py:1177
