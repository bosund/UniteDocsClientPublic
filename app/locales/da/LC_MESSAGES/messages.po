msgstr "Mere fra Unite Apps"

#: app/welcome.py:502
msgid "Unite Docs"
msgstr "Unite Docs"

#: app/welcome.py:506
msgid "Saml sagen, ryd op og send den af sted — uden at printe en eneste side."
msgstr "Saml sagen, ryd op og send den af sted — uden at printe en eneste side."

