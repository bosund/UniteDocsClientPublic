#: app/welcome.py:147
msgid ""
"Skær skæve scannerkanter og alt for brede margener væk med ét træk. "
"Bilaget ser trykklart ud — uden en tur forbi kopimaskinen."
msgstr ""
"Beskjær bort skjeve skannerkanter og alt for brede marger med ett drag. "
"Bilaget ser trykkeklart ut — uten en tur om kopimaskinen."

#: app/welcome.py:152
msgid ""
"Sæt 40 bilag i rækkefølge efter navn eller dato med ét klik. Der ryger "
"kvarteret, hvor du ellers trak filer på plads én ad gangen."
msgstr ""
"Sorter 40 bilag etter navn eller dato med ett klikk. Der forsvant "
"kvarteret du ellers brukte på å dra filer på plass én om gangen."

#: app/welcome.py:157
msgid ""
"Læg en forside eller en skilleside ind præcis dér, hvor den skal være. "
"Overskrift og tekst skriver du her — ingen omvej om Word."
msgstr ""
"Legg inn en forside eller et skilleark akkurat der det skal være. "
"Overskrift og tekst skriver du her — ingen omvei om Word."

#: app/welcome.py:162
msgid ""
"En scanning er et billede — du kan hverken søge eller markere i den. Kør "
"tekstgenkendelse én gang, så opfører siden sig som ethvert andet "
"dokument: du kan søge, overstrege og maskere ord."
msgstr ""
"En skanning er et bilde — du kan verken søke i den eller markere i den. "
"Kjør tekstgjenkjenning én gang, så oppfører siden seg som ethvert annet "
"dokument: du kan søke, utheve og maskere enkeltord."

#: app/welcome.py:169
msgid "Masker og anonymiser"
msgstr "Masker og anonymiser"

#: app/welcome.py:170
msgid ""
"Den sorte streg fjerner teksten under sig — den lægger sig ikke bare "
"ovenpå. Anonymiser gennemgår selv hver eneste side for navne, CPR-numre "
"og adresser, så du slipper for at nærlæse 200 sider før aktindsigten "
"sendes."
msgstr ""
"Den svarte streken fjerner teksten under seg — den legger seg ikke bare "
"oppå. Anonymiser går selv gjennom hver enkelt side etter navn, CPR-numre "
"og adresser, slik at du slipper å lese 200 sider før innsynet sendes."

#: app/welcome.py:176
msgid ""
"Skal sagen forbi en AI? Kopiér teksten med navne, CPR-numre og adresser "
"byttet ud med Person 1 og Advokat 2 — samme person får samme etiket i "
"hele bundtet, så teksten stadig giver mening. Nøglen tilbage beholder du "
"selv."
msgstr ""
"Skal saken innom en KI? Kopier teksten med navn, CPR-numre og adresser "
"byttet ut med Person 1 og Advokat 2 — samme person får samme etikett i "
"hele bunken, så teksten fortsatt gir mening. Nøkkelen tilbake beholder du"
" selv."

#: app/welcome.py:181
msgid "Fremhæv, tegn og marker"
msgstr "Uthev, tegn og marker"

#: app/welcome.py:182
msgid ""
"Gul overstregning på det afgørende afsnit, en pil eller en note ved siden"
" af. Modtageren ser pointen med det samme — også på den udskrevne udgave."
msgstr ""
"En gul utheving på det avgjørende avsnittet, en pil eller en merknad ved "
"siden av. Mottakeren ser poenget med én gang — også på utskriften."

#: app/welcome.py:187
msgid ""
"Saml hele sagen i én PDF til retten, eller gem hver fil for sig. "
"Rækkefølgen bliver den, du ser på skærmen — der er ingen overraskelser i "
"den færdige fil."
msgstr ""
"Samle hele saken i én PDF til retten, eller lagre hver fil for seg. "
"Rekkefølgen blir den du ser på skjermen — ingen overraskelser i den "
"ferdige filen."

#: app/welcome.py:192
msgid ""
"Åbn en låst PDF én gang, så husker programmet koden. Næste gang — og "
"næste uge — åbner filen af sig selv."
msgstr ""
"Åpne en låst PDF én gang, så husker programmet passordet. Neste gang — og"
" neste uke — åpner filen seg av seg selv."

#: app/welcome.py:200
msgid "Vejledninger og svar på det, der ellers koster et opkald til IT."
msgstr "Veiledninger og svar på det som ellers koster en telefon til IT."

#: app/welcome.py:203
msgid "Slå en virksomhed op: CVR-nummer, adresse og ejerkreds på få sekunder."
msgstr "Slå opp et foretak: organisasjonsnummer, adresse og eiere på få sekunder."

#: app/welcome.py:206
msgid "Nyheder, opdateringer og de øvrige Unite-programmer."
msgstr "Nyheter, oppdateringer og de øvrige Unite-programmene."

#: app/welcome.py:470
msgid "Det kan du med Unite Docs"
msgstr "Dette kan du med Unite Docs"

#: app/welcome.py:476
msgid "Mere fra Unite Apps"
msgstr "Mer fra Unite Apps"

#: app/welcome.py:502
msgid "Unite Docs"
msgstr "Unite Docs"

#: app/welcome.py:506
msgid "Saml sagen, ryd op og send den af sted — uden at printe en eneste side."
msgstr ""
"Samle saken, rydd opp og send den av gårde — uten å skrive ut en eneste "
"side."

#: app/welcome.py:532
msgid "Træk dine PDF'er herind — eller klik for at finde dem"
msgstr "Dra PDF-ene dine hit — eller klikk for å finne dem"

