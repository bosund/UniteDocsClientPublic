msgstr "Todas las páginas desde el principio (%d)"

#: app/dialogs.py:1034
msgid "Tidligere fravalg huskes og kan slås til igen i listen."
msgstr ""
"Las exclusiones anteriores se recuerdan y pueden volver a activarse en la"
" lista."

#: app/dialogs.py:1039
msgid "Læs også scannede sider (tekstgenkendelse)"
msgstr "Leer también las páginas escaneadas (reconocimiento de texto)"

#: app/dialogs.py:1043
msgid "Scannede sider tager længere tid, men findes ellers slet ikke."
msgstr ""
"Las páginas escaneadas tardan más, pero de lo contrario no se encuentran "
"en absoluto."

#: app/dialogs.py:1102
#, python-format
msgid "%(valgt)d af %(alle)d forekomster maskeres"
msgstr "Se tacharán %(valgt)d de %(alle)d apariciones"

#: app/dialogs.py:1111
msgid "Vælg alle"
msgstr "Seleccionar todo"

#: app/dialogs.py:1112
msgid "Fravælg alle"
msgstr "Deseleccionar todo"

#: app/dialogs.py:1124
msgid "Masker de valgte"
msgstr "Tachar lo seleccionado"

#: app/dialogs.py:1139
#, python-format
msgid "%(fund)d forekomster fordelt på %(grupper)d værdier"
msgstr "%(fund)d apariciones repartidas en %(grupper)d valores"

#: app/dialogs.py:1146
msgid ""
"Alt er valgt. Fjern fluebenet ved det der IKKE skal maskeres — fx "
"advokatens eller dommerens navn."
msgstr ""
"Todo está seleccionado. Desmarque lo que NO deba tacharse — por ejemplo, "
"el nombre del abogado o del juez."

#: app/dialogs.py:1154 app/dialogs.py:1562
#, python-format
msgid ""
"%d side(r) blev læst med tekstgenkendelse. Kontrollér resultatet — "
"genkendelsen kan have overset tekst."
msgstr ""
"%d página(s) se leyeron con reconocimiento de texto. Compruebe el "
"resultado: el reconocimiento puede haber pasado texto por alto."

#: app/dialogs.py:1160
#, python-format
msgid "%d side(r) er læst som engelsk tekst ud over dansk."
msgstr "%d página(s) se han leído como texto en inglés además de en danés."

#: app/dialogs.py:1167
#, python-format
msgid ""
"%d side(r) ser engelske ud, men den engelske sprogmodel er ikke "
"installeret. Numre og adresser er fundet, men engelske navne kan være "
"overset."
msgstr ""
"%d página(s) parecen estar en inglés, pero el modelo de idioma inglés no "
"está instalado. Se han encontrado números y direcciones, pero puede que "
"se hayan pasado por alto nombres en inglés."

#: app/dialogs.py:1173 app/dialogs.py:1569
#, python-format
msgid "%d side(r) kunne ikke læses."
msgstr "No se pudieron leer %d página(s)."

#: app/dialogs.py:1177
