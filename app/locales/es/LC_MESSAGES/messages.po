msgstr "%(tegn)s caracteres de %(sider)d página(s)."

#: app/dialogs.py:1549
#, python-format
msgid "%d personoplysning(er) er byttet ud med pseudonymer."
msgstr "%d dato(s) personal(es) se han sustituido por seudónimos."

#: app/dialogs.py:1553
msgid "Der blev ikke fundet nogen personoplysninger at bytte ud."
msgstr "No se encontraron datos personales que sustituir."

#: app/dialogs.py:1556
msgid "Teksten er IKKE pseudonymiseret."
msgstr "El texto NO está seudonimizado."

#: app/dialogs.py:1575
msgid "Gem navneoversigt…"
msgstr "Guardar el índice de nombres…"

#: app/dialogs.py:1579
msgid ""
"Oversigten kobler pseudonym og original. Den må ikke uploades sammen med "
"teksten."
msgstr ""
"El índice vincula el seudónimo con el original. No debe subirse junto con"
" el texto."

