msgstr "%d personenbezogene Angabe(n) wurden durch Pseudonyme ersetzt."

#: app/dialogs.py:1553
msgid "Der blev ikke fundet nogen personoplysninger at bytte ud."
msgstr "Es wurden keine personenbezogenen Daten zum Ersetzen gefunden."

#: app/dialogs.py:1556
